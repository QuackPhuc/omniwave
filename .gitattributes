# Auto-detect text files and normalize line endings
* text=auto

# Python
*.py text diff=python
*.pyx text diff=python
*.pxd text diff=python

# Config
*.yaml text
*.yml text
*.toml text
*.cfg text
*.ini text

# Documentation
*.md text diff=markdown
*.rst text
*.txt text
LICENSE text

# Shell
*.sh text eol=lf
*.bash text eol=lf

# Windows
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary
*.pt binary
*.pth binary
*.ckpt binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.whl binary
*.so binary
*.dylib binary
